<idea-plugin>
    <id>com.draken.blackdraken</id>
    <name>Black Draken</name>
    <vendor email="leonardofavion@gmail.com" url="https://github.com/10Draken01">Draken</vendor>

    <description><![CDATA[
        <p><b>Black Draken</b> is a dark neon theme with a demonic black and neon red palette.</p>
        <p>Includes an optional editor background image with glitch effects, and lightweight red particles while you type. All effects can be toggled in Settings | Appearance | Black Draken.</p>
    ]]></description>

    <change-notes><![CDATA[
        <ul><li>Initial release.</li></ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="com.draken.blackdraken.theme" path="/themes/BlackDraken.theme.json"/>
        <bundledColorScheme id="Black Draken" path="/themes/BlackDraken"/>
        <editorFactoryListener implementation="com.draken.blackdraken.particles.ParticleEditorListener"/>
        <applicationConfigurable parentId="appearance"
                                 instance="com.draken.blackdraken.settings.BlackDrakenConfigurable"
                                 id="com.draken.blackdraken.settings"
                                 displayName="Black Draken"/>
    </extensions>
</idea-plugin>